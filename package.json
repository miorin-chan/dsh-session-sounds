{
  "name": "@miorin/dsh-session-sounds",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Plays distinct sounds in the macOS desktop app for successful replies, questions, and approval requests.",
  "type": "module",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "audio",
    "notifications",
    "macos"
  ],
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "AGENTS.md",
    "AGENTS.local.md",
    "docs/README.md",
    "README.zh.md",
    "src",
    "scripts",
    "tsconfig.json",
    "tsconfig.tools.json"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.5"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "npm run build:tools && node scripts/build.mjs",
    "prepare": "npm run build 1>&2",
    "test": "npm run build && npm run test:unit --",
    "test:unit": "node --test",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run build:tools && node scripts/build.mjs --check && npm run test:unit && npm run typecheck && node scripts/sync-types.mjs --check",
    "build:tools": "tsc -p tsconfig.tools.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-approval": "0.2.2-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.2-rc.5",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "typescript": "5.7.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
